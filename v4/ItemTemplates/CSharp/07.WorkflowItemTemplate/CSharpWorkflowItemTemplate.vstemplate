<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" xmlns:sdk="http://schemas.microsoft.com/developer/vstemplate-sdkextension/2010">
	<TemplateData>
		<Name>07. C# Workflow Class</Name>
		<Description>Creates a C# class scaffold for a Dataverse Custom Workflow Activity, including an Execute method stub, tracing setup, secure/unsecure configuration placeholders, and regions for defining input/output arguments.</Description>
		<DefaultName>Class.cs</DefaultName>
		<TemplateID>AAAAAAAA-AAAA-AAAA-BBBB-000000000003</TemplateID>
		<Icon>icon.png</Icon>
		<ProjectType>CSharp</ProjectType>
		<ProjectSubType>Visual C#</ProjectSubType>
		<AppliesTo>CSharp</AppliesTo>
		<RequiredFrameworkVersion>4.0</RequiredFrameworkVersion>
		<NumberOfParentCategoriesToRollUp>0</NumberOfParentCategoriesToRollUp>
		<SortOrder>170</SortOrder>
	</TemplateData>
	<TemplateContent>
		<ProjectItem ReplaceParameters="true" TargetFileName="$Class$$PluginOrder$.cs">Class.cs</ProjectItem>
	</TemplateContent>
	<WizardExtension>
		<Assembly>DynamicsCrm.DevKit, Version=4.00.00.00, Culture=Neutral, PublicKeyToken=null</Assembly>
		<FullClassName>DynamicsCrm.DevKit.Wizard.ItemTemplates.Workflow</FullClassName>
	</WizardExtension>
</VSTemplate>