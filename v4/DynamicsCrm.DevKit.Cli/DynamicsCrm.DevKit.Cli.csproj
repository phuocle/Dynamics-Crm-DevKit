<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<IsPublishable>True</IsPublishable>
		<SignAssembly>True</SignAssembly>
		<AssemblyOriginatorKeyFile>..\DynamicsCrm.DevKit.pfx</AssemblyOriginatorKeyFile>
		<AssemblyVersion>3.66.66.66</AssemblyVersion>
		<FileVersion>3.66.66.66</FileVersion>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<RepositoryUrl>https://github.com/phuocle/Dynamics-Crm-DevKit</RepositoryUrl>
		<Company>PhuocLe</Company>
		<Product>DynamicsCrm.DevKit.Cli</Product>
		<Copyright>Copyright © PhuocLe 2016 - 2026</Copyright>
		<PackageProjectUrl>https://github.com/phuocle/Dynamics-Crm-DevKit</PackageProjectUrl>
		<Version>3.66.66.66</Version>
		<OutputType>Exe</OutputType>
		<StartupObject>DynamicsCrm.DevKit.Cli.Program</StartupObject>
		<BaseOutputPath>bin</BaseOutputPath>
		<DelaySign>False</DelaySign>
		<ApplicationIcon>icon.ico</ApplicationIcon>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="docs\**" />
	  <Compile Remove="images\**" />
	  <Compile Remove="license\**" />
	  <Compile Remove="Nuget\**" />
	  <EmbeddedResource Remove="docs\**" />
	  <EmbeddedResource Remove="images\**" />
	  <EmbeddedResource Remove="license\**" />
	  <EmbeddedResource Remove="Nuget\**" />
	  <None Remove="docs\**" />
	  <None Remove="images\**" />
	  <None Remove="license\**" />
	  <None Remove="Nuget\**" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="icon.ico" />
	</ItemGroup>
	<PropertyGroup>
		<NoWarn>CVSTBLD002</NoWarn>
	</PropertyGroup>
	<ItemGroup>
	  <PackageReference Include="CmdLine" Version="1.0.7.509" />
	  <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.9" />
	  <PackageReference Include="Microsoft.VisualStudio.Shell.Framework" Version="17.14.40264" />
	  <PackageReference Include="NuGet.Packaging" Version="6.14.0" />
	  <PackageReference Include="NuGet.Protocol" Version="6.14.0" />
	</ItemGroup>
	<Import Project="..\DynamicsCrm.DevKit.Shared\DynamicsCrm.DevKit.Shared.projitems" Label="Shared" />
</Project>
