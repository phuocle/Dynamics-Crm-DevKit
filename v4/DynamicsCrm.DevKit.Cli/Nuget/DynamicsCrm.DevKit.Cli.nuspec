<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <id>DynamicsCrm.DevKit.Cli</id>
        <title>DynamicsCrm.DevKit.Cli - CLI for DynamicsCrm.DevKit tool</title>
        <version>4.00.00.00</version>
        <authors>PhuocLe</authors>
        <license type="file">license\LICENSE.txt</license>
        <projectUrl>https://github.com/phuocle/Dynamics-Crm-DevKit</projectUrl>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <description>CLI for DynamicsCrm.DevKit tool</description>
        <language>en-US</language>
        <tags>Dynamics, Dynamics365, DynamicsCrm, Crm, Cli, DevKit, Analyzer, Dataverse</tags>
		<icon>images\icon.png</icon>
		<readme>docs\README.md</readme>
    </metadata>
    <files>
        <!-- Main CLI executable and config -->
        <file src="..\bin\Release\net48\DynamicsCrm.DevKit.Cli.exe" target="tools\DynamicsCrm.DevKit.Cli.exe" />
        <file src="..\bin\Release\net48\DynamicsCrm.DevKit.Cli.exe.config" target="tools\DynamicsCrm.DevKit.Cli.exe.config" />

        <!-- Command line parsing -->
        <file src="..\bin\Release\net48\CmdLine.dll" target="tools\CmdLine.dll" />

        <!-- Dataverse/CRM connectivity (modern SDK) -->
        <file src="..\bin\Release\net48\Microsoft.PowerPlatform.Dataverse.Client.dll" target="tools\Microsoft.PowerPlatform.Dataverse.Client.dll" />

        <!-- NuGet package management -->
        <file src="..\bin\Release\net48\NuGet.Packaging.dll" target="tools\NuGet.Packaging.dll" />
        <file src="..\bin\Release\net48\NuGet.Common.dll" target="tools\NuGet.Common.dll" />
        <file src="..\bin\Release\net48\NuGet.Frameworks.dll" target="tools\NuGet.Frameworks.dll" />
        <file src="..\bin\Release\net48\NuGet.Versioning.dll" target="tools\NuGet.Versioning.dll" />
        <file src="..\bin\Release\net48\NuGet.Protocol.dll" target="tools\NuGet.Protocol.dll" />

        <!-- Visual Studio Shell Framework (minimal required) -->
        <file src="..\bin\Release\net48\Microsoft.VisualStudio.Shell.Framework.dll" target="tools\Microsoft.VisualStudio.Shell.Framework.dll" />

        <!-- JSON serialization -->
        <file src="..\bin\Release\net48\Newtonsoft.Json.dll" target="tools\Newtonsoft.Json.dll" />

        <!-- Documentation and assets -->
        <file src="..\license\LICENSE.txt" target="license\LICENSE.txt" />
        <file src="..\docs\README.md" target="docs\README.md" />
        <file src="..\images\icon.png" target="images\icon.png" />
    </files>
</package>