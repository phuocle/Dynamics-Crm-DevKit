<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <id>DynamicsCrm.DevKit.Cli</id>
        <title>DynamicsCrm.DevKit.Cli - CLI for DynamicsCrm.DevKit tool</title>
        <version>4.00.00.00</version>
        <authors>PhuocLe</authors>
        <license type="file">license\LICENSE.txt</license>
        <projectUrl>https://github.com/phuocle/Dynamics-Crm-DevKit</projectUrl>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <description>Command Line Interface (CLI) for DynamicsCrm.DevKit, a comprehensive toolkit for Dynamics 365/Dataverse development. This tool helps automate common development tasks such as deploying plugins, workflows, web resources, and reports directly from the command line.</description>
        <language>en-US</language>
        <tags>Dynamics, Dynamics365, DynamicsCrm, Crm, Cli, DevKit, Analyzer, Dataverse, PowerPlatform, Xrm</tags>
		<icon>images\icon.png</icon>
		<readme>docs\README.md</readme>
    </metadata>
