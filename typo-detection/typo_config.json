  "context_rules": {
    "code_identifiers": {
      "min_length": 3,
      "ignore_camel_case": true,
      "ignore_pascal_case": true,
      "ignore_snake_case": true,
      "ignore_kebab_case": true,
      "ignore_all_caps": true
    },
    "comments": {
      "check_spelling": true,
      "check_grammar": false,
      "ignore_urls": true,
      "ignore_code_references": true
    },
    "strings": {
      "check_spelling": true,
      "ignore_format_strings": true,
      "ignore_regex_patterns": true,
      "ignore_sql_queries": true
    },
    "documentation": {
      "check_spelling": true,
      "check_grammar": false,
      "ignore_code_blocks": true,
      "ignore_urls": true
    }
  },
  "severity_levels": {
    "critical": ["accessibility", "security", "performance"],
    "high": ["functionality", "usability"],
    "medium": ["documentation", "comments"],
    "low": ["style", "formatting"]
  },
  "output_formats": {
    "json": true,
    "markdown": true,
    "text": false,
    "html": false,
    "xml": false,
    "csv": false
  },
  "correction_settings": {
    "auto_fix": false,
    "backup_files": true,
    "max_edit_distance": 2,
    "min_confidence": 0.7,
    "suggest_count": 3
  }
}