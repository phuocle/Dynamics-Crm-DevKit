# DynamicsCrm.DevKit MCP Server - Connection Parameters
# Copy this file to .env and fill in your values.
# .env is gitignored and will NOT be committed.

# Authentication type: ClientSecret, Interactive, DeviceCode, FromPac
DEVKIT_AUTH_TYPE=ClientSecret

# Dataverse environment URL
DEVKIT_URL=https://YOUR_ORG.crm5.dynamics.com

# Azure AD Application (Client) ID
DEVKIT_CLIENT_ID=YOUR_CLIENT_ID

# Azure AD Client Secret
DEVKIT_CLIENT_SECRET=YOUR_CLIENT_SECRET

# PAC CLI profile name (only for FromPac auth type)
# DEVKIT_PAC_PROFILE=your-profile-name
