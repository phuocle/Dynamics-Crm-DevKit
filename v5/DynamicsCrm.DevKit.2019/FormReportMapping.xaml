<Window x:Class="DynamicsCrm.DevKit2019.FormReportMapping"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upload Dynamics 365 Report"
        Width="720"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="10">
        <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="File" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="textboxFile" IsReadOnly="True" Margin="0,0,0,5" />

                <Label Grid.Row="1" Grid.Column="0" Content="Report" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="comboReports" DisplayMemberPath="DisplayReportName" Margin="0,0,0,5" SelectionChanged="ComboReports_SelectionChanged" />
            </Grid>
        </Border>

        <TextBlock x:Name="textStatus" Foreground="Red" Margin="5,0,5,8" Visibility="Collapsed" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="buttonOK" Content="OK" Width="100" Height="30" Margin="5,0,5,0" Click="ButtonOK_Click" />
            <Button Grid.Column="2" Content="Cancel" Width="100" Height="30" Margin="5,0,0,0" IsCancel="True" Click="ButtonCancel_Click" />
        </Grid>
    </StackPanel>
</Window>
