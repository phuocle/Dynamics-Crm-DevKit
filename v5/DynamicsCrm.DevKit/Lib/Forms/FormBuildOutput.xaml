<forms:BaseDialogWindow  xmlns:forms="clr-namespace:DynamicsCrm.DevKit.Lib.Forms"
        x:Class="DynamicsCrm.DevKit.Lib.Forms.FormBuildOutput"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Width="800" Height="400" HasMaximizeButton="True" HasMinimizeButton="True"
    >
    <forms:BaseDialogWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="StyleResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </forms:BaseDialogWindow.Resources>
    <DockPanel x:Name="dockPanel" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Padding="10,5,10,5" Background="#007ACC" x:Name="StatusBlock">
            <Run x:Name="StatusText" Foreground="White" FontWeight="Bold">Building TypeScript...</Run>
        </TextBlock>
        <TextBox DockPanel.Dock="Top" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="5,5,5,5" Margin="5,5,5,5" x:Name="OutputTextbox" TextWrapping="Wrap" AcceptsReturn="true" AcceptsTab="True" FontFamily="Consolas" FontSize="12" IsReadOnly="True" Background="#1E1E1E" Foreground="#DCDCDC" />
    </DockPanel>
</forms:BaseDialogWindow>
