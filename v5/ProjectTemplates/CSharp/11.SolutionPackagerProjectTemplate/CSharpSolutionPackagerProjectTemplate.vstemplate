<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" xmlns:sdk="http://schemas.microsoft.com/developer/vstemplate-sdkextension/2010">
	<TemplateData>
		<Name>11. Solution Packager Project</Name>
		<Description>Project template for Dataverse Solution Packager. Use this template to automate extraction and packing of Dataverse solutions for ALM scenarios.</Description>
		<DefaultName>SolutionPackagerProject</DefaultName>
		<TemplateID>DynamicsCrm.DevKit.CSharpSolutionPackagerProject</TemplateID>
		<TemplateGroupID>DynamicsCrm.DevKit</TemplateGroupID>
		<Icon>icon.png</Icon>
		<ProjectType>CSharp</ProjectType>
		<RequiredFrameworkVersion>4.0</RequiredFrameworkVersion>
		<CreateInPlace>true</CreateInPlace>
		<ProjectTypeTag>DynamicsCrm.DevKit</ProjectTypeTag>
		<LanguageTag>CSharp</LanguageTag>
		<PlatformTag>Windows</PlatformTag>
		<SortOrder>200</SortOrder>
	</TemplateData>
	<TemplateContent>
		<Project TargetFileName="$SafeProjectName$.csproj" File="ProjectTemplate.csproj.template" ReplaceParameters="true">			<ProjectItem ReplaceParameters="false" TargetFileName="README.md">README.md</ProjectItem>			<ProjectItem ReplaceParameters="false" TargetFileName="mapping.xml">mapping.xml</ProjectItem>
			<ProjectItem ReplaceParameters="true" TargetFileName="Extract-Both.bat">Extract-Both.bat</ProjectItem>
			<ProjectItem ReplaceParameters="true" TargetFileName="Pack-Both.bat">Pack-Both.bat</ProjectItem>
		</Project>
	</TemplateContent>
	<WizardExtension>
		<Assembly>DynamicsCrm.DevKit, Version=4.99.99.99, Culture=Neutral, PublicKeyToken=null</Assembly>
		<FullClassName>DynamicsCrm.DevKit.Wizard.ProjectTemplates.SolutionPackager</FullClassName>
	</WizardExtension>
</VSTemplate>