<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>$NameSpace$</RootNamespace>
    <AssemblyName>$ProjectName$</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Title>$ProjectName$</Title>
    <Description>Generated by DynamicsCrm.DevKit - $DevKitVersion$ - https://github.com/phuocle/Dynamics-Crm-DevKit</Description>
    <Product>$ProjectName$</Product>
    <Copyright>Copyright © $year$</Copyright>
    <Version>4.44.44.44</Version>
    <AssemblyVersion>4.44.44.44</AssemblyVersion>
    <FileVersion>4.44.44.44</FileVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>..\Release\console\$ProjectName$</OutputPath>
    <NoWarn>CS8032</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DynamicsCrm.DevKit.Analyzers" Version="$DynamicsCrm.DevKit.Analyzers.Version$">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="$Microsoft.PowerPlatform.Dataverse.Client.Version$" />
    <PackageReference Include="NSubstitute" Version="$NSubstitute.Version$" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
    <None Include="README.md" />
  </ItemGroup>
  <Import Project="..\$SharedProject$\$SharedProject$.projitems" Label="Shared" Condition="Exists('..\$SharedProject$\$SharedProject$.projitems')" />
</Project>
<!-- $DevKitVersion$ -->
