<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net462</TargetFramework>
		<LangVersion>latest</LangVersion>
		<RootNamespace>$NameSpace$</RootNamespace>
		<AssemblyName>$ProjectName$</AssemblyName>
		<IsTestProject>true</IsTestProject>
		<Title>$ProjectName$</Title>
		<Description>Generated by DynamicsCrm.DevKit - $DevKitVersion$ - https://github.com/phuocle/Dynamics-Crm-DevKit</Description>
		<Product>$ProjectName$</Product>
		<Copyright>Copyright © $year$</Copyright>
		<Version>4.12.34.56</Version>
		<AssemblyVersion>4.12.34.56</AssemblyVersion>
		<FileVersion>4.12.34.56</FileVersion>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<OutputPath>bin\Debug\</OutputPath>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<NoWarn>MSTEST0001</NoWarn>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<OutputPath>..\Release\uitest\</OutputPath>
		<DebugType>pdbonly</DebugType>
		<Optimize>true</Optimize>
		<DefineConstants>TRACE</DefineConstants>
		<NoWarn>MSTEST0001</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="DynamicsCrm.DevKit.Analyzers" Version="$DynamicsCrm.DevKit.Analyzers.Version$">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Dynamics365.UIAutomation.Api" Version="9.2.21084.148" />
		<PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="$Microsoft.PowerPlatform.Dataverse.Client.Version$" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.2.3" />
		<PackageReference Include="MSTest.TestFramework" Version="4.2.3" />
		<PackageReference Include="Selenium.WebDriver" Version="3.141.0" />
		<PackageReference Include="Selenium.WebDriver.ChromeDriver" Version="149.0.7827.15500" />
		<PackageReference Include="Selenium.Support" Version="3.141.0" />
	</ItemGroup>
	<ItemGroup>
		<None Include="$ProjectName$.runsettings" />
		<None Include="App.config" />
		<None Include="README.md" />
	</ItemGroup>
</Project>
