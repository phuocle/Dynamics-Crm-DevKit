<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>$NameSpace$</RootNamespace>
    <AssemblyName>$ProjectName$</AssemblyName>
    <Title>$ProjectName$</Title>
    <Description>Generated by DynamicsCrm.DevKit - $DevKitVersion$ - https://github.com/phuocle/Dynamics-Crm-DevKit</Description>
    <Product>$ProjectName$</Product>
    <Copyright>Copyright © $year$</Copyright>
    <Version>4.99.99.99</Version>
    <AssemblyVersion>4.99.99.99</AssemblyVersion>
    <FileVersion>4.99.99.99</FileVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <OutputPath>..\Release\web\$ProjectName$</OutputPath>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants></DefineConstants>
    <NoWarn>CS8032</NoWarn>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DynamicsCrm.DevKit.Analyzers" Version="$DynamicsCrm.DevKit.Analyzers.Version$">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
		<Folder Include="html\" />
		<Folder Include="css\" />
		<Folder Include="entities\" />
    <Folder Include="js\" />
		<Folder Include="lib\" />
		<Folder Include="images\" />
		<Folder Include="resources\" />
	</ItemGroup>
  <ItemGroup>
    <None Include="README.md" />
  </ItemGroup>
</Project>
<!-- $DevKitVersion$ -->
