<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" xmlns:sdk="http://schemas.microsoft.com/developer/vstemplate-sdkextension/2010">
	<TemplateData>
		<Name>06. WebResource Project</Name>
		<Description>Template for Dataverse Web Resources using devkit.js and DynamicsCrm.DevKit tooling.</Description>
		<DefaultName>WebResourceProject</DefaultName>
		<TemplateID>DynamicsCrm.DevKit.CSharpWebResourceProject</TemplateID>
		<TemplateGroupID>DynamicsCrm.DevKit</TemplateGroupID>
		<Icon>icon.png</Icon>
		<ProjectType>CSharp</ProjectType>
		<RequiredFrameworkVersion>4.0</RequiredFrameworkVersion>
		<CreateInPlace>true</CreateInPlace>
		<ProjectTypeTag>DynamicsCrm.DevKit</ProjectTypeTag>
		<LanguageTag>CSharp</LanguageTag>
		<PlatformTag>Windows</PlatformTag>
		<SortOrder>150</SortOrder>
	</TemplateData>
	<TemplateContent>
		<Project TargetFileName="$SafeProjectName$.csproj" File="ProjectTemplate.csproj.template" ReplaceParameters="true">
			<Folder Name="lib" />
			<Folder Name="entities" />
			<Folder Name="images" />
			<Folder Name="resources" />
			<Folder Name="html" />
			<Folder Name="css" />
			<Folder Name="js" />
			<ProjectItem ReplaceParameters="false" TargetFileName="README.md">README.md</ProjectItem>
			<ProjectItem ReplaceParameters="true" TargetFileName="deploy.debug.bat">deploy.debug.bat</ProjectItem>
			<ProjectItem ReplaceParameters="true" TargetFileName="package.json">package.json</ProjectItem>
			<ProjectItem ReplaceParameters="true" TargetFileName="jsconfig.json">jsconfig.json</ProjectItem>
			<ProjectItem ReplaceParameters="true" TargetFileName="entities\devkit.d.ts">devkit.d.ts</ProjectItem>
			<ProjectItem ReplaceParameters="true" TargetFileName="lib\devkit.js">devkit.js</ProjectItem>
			<ProjectItem ReplaceParameters="true" TargetFileName="entities\generator.form.bat">generator.form.bat</ProjectItem>
			<ProjectItem ReplaceParameters="true" TargetFileName="entities\generator.webapi.bat">generator.webapi.bat</ProjectItem>
		</Project>
	</TemplateContent>
	<WizardExtension>
		<Assembly>DynamicsCrm.DevKit, Version=4.99.99.99, Culture=Neutral, PublicKeyToken=null</Assembly>
		<FullClassName>DynamicsCrm.DevKit.Wizard.ProjectTemplates.WebResource</FullClassName>
	</WizardExtension>
</VSTemplate>