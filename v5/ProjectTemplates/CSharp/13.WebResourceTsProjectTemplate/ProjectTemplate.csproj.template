<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net462</TargetFramework>
		<LangVersion>latest</LangVersion>
		<OutputType>Library</OutputType>
		<RootNamespace>$NameSpace$</RootNamespace>
		<AssemblyName>$ProjectName$</AssemblyName>
		<TypeScriptCompileBlocked>True</TypeScriptCompileBlocked>
		<Title>$ProjectName$</Title>
		<Description>Generated by DynamicsCrm.DevKit - $DevKitVersion$ - https://github.com/phuocle/Dynamics-Crm-DevKit</Description>
		<Product>$ProjectName$</Product>
		<Copyright>Copyright © $year$</Copyright>
		<Version>4.12.34.56</Version>
		<AssemblyVersion>4.12.34.56</AssemblyVersion>
		<FileVersion>4.12.34.56</FileVersion>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<OutputPath>bin\Debug\</OutputPath>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<OutputPath>..\Release\web\$ProjectName$</OutputPath>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants></DefineConstants>
		<PlatformTarget>x64</PlatformTarget>
		<NoWarn>CS8032</NoWarn>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="DynamicsCrm.DevKit.Analyzers" Version="$DynamicsCrm.DevKit.Analyzers.Version$">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<Folder Include="html\" />
		<Folder Include="css\" />
		<Compile Remove="build\**" />
		<Folder Include="entities\" />
		<Folder Include="lib\" />
		<Folder Include="images\" />
		<Folder Include="resources\" />
	</ItemGroup>
	<ItemGroup>
		<None Include="deploy.debug.bat" />
		<None Include="deploy.release.bat" />
		<None Include="package.json" />
		<None Include=".eslintrc.json" />
		<None Include="tsconfig.json" />
		<None Include="README.md" />
		<Content Include="build.js" />
		<TypeScriptCompile Include="lib\devkit.d.ts" />
		<TypeScriptCompile Include="lib\devkit.ts" />
		<None Include="entities\generator.form.bat" />
		<None Include="entities\generator.webapi.bat" />
	</ItemGroup>
</Project>
<!-- $DevKitVersion$ -->
