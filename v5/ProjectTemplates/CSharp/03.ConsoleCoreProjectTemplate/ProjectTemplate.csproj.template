<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>$NameSpace$</RootNamespace>
		<AssemblyName>$ProjectName$</AssemblyName>
		<ImplicitUsings>enable</ImplicitUsings>
		<PlatformTarget>x64</PlatformTarget>
		<Title>$ProjectName$</Title>
		<Description>Generated by DynamicsCrm.DevKit - $DevKitVersion$ - https://github.com/phuocle/Dynamics-Crm-DevKit</Description>
		<Product>$ProjectName$</Product>
		<Copyright>Copyright © $year$</Copyright>
		<Version>4.99.99.99</Version>
		<AssemblyVersion>4.99.99.99</AssemblyVersion>
		<FileVersion>4.99.99.99</FileVersion>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>
	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<OutputPath>bin\Debug\</OutputPath>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<OutputPath>..\Release\consolecore\$ProjectName$</OutputPath>
		<NoWarn>CS8032</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Azure.Identity" Version="$Azure.Identity.Version$" />
		<PackageReference Include="DynamicsCrm.DevKit.Analyzers" Version="$DynamicsCrm.DevKit.Analyzers.Version$" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="$Microsoft.Extensions.Configuration.Version$" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="$Microsoft.Extensions.Configuration.Json.Version$" />
		<PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="$Microsoft.PowerPlatform.Dataverse.Client.Version$" />
		<PackageReference Include="NSubstitute" Version="$NSubstitute.Version$" />
	</ItemGroup>
	<ItemGroup>
		<None Update="AppSettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="README.md" />
	</ItemGroup>
	<Import Project="..\$SharedProject$\$SharedProject$.projitems" Label="Shared" Condition="Exists('..\$SharedProject$\$SharedProject$.projitems')" />
</Project>
<!-- $DevKitVersion$ -->