<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net462</TargetFramework>
		<LangVersion>latest</LangVersion>
		<RootNamespace>$NameSpace$</RootNamespace>
		<AssemblyName>$ProjectName$</AssemblyName>
		<PlatformTarget>x64</PlatformTarget>
		<IsTestProject>true</IsTestProject>
		<Title>$ProjectName$</Title>
		<Description>Generated by DynamicsCrm.DevKit - $DevKitVersion$ - https://github.com/phuocle/Dynamics-Crm-DevKit</Description>
		<Product>$ProjectName$</Product>
		<Copyright>Copyright © $year$</Copyright>
		<Version>4.12.34.56</Version>
		<AssemblyVersion>4.12.34.56</AssemblyVersion>
		<FileVersion>4.12.34.56</FileVersion>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<OutputPath>bin\Debug\</OutputPath>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<NoWarn>MSTEST0001</NoWarn>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<OutputPath>..\Release\test\</OutputPath>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<NoWarn>CS8032;MSTEST0001</NoWarn>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Bogus" Version="$Bogus.Version$" />
		<PackageReference Include="DynamicsCrm.DevKit.Analyzers" Version="$DynamicsCrm.DevKit.Analyzers.Version$">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="FakeXrmEasy.v9" Version="2.*" />
		<PackageReference Include="FakeXrmEasy.Abstractions.v9" Version="2.*" />
		<PackageReference Include="FakeXrmEasy.Core.v9" Version="2.*" />
		<PackageReference Include="FakeXrmEasy.Messages.v9" Version="2.*" />
		<PackageReference Include="FakeXrmEasy.Plugins.v9" Version="2.*" />
		<PackageReference Include="FakeXrmEasy.CodeActivities.v9" Version="2.*" />
		<PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="$Microsoft.CrmSdk.CoreAssemblies.Version$" />
		<PackageReference Include="Microsoft.CrmSdk.Workflow" Version="$Microsoft.CrmSdk.Workflow.Version$" />
		<PackageReference Include="MSTest.TestAdapter" Version="$MSTest.TestAdapter.Version$" />
		<PackageReference Include="MSTest.TestFramework" Version="$MSTest.TestFramework.Version$" />
		<PackageReference Include="NSubstitute" Version="$NSubstitute.Version$" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\$ProjectProxyTypes$\$ProjectProxyTypes$.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Include="README.md" />
	</ItemGroup>
	<Import Project="..\$SharedTestProject$\$SharedTestProject$.projitems" Label="Shared" Condition="Exists('..\$SharedTestProject$\$SharedTestProject$.projitems')" />
</Project>
