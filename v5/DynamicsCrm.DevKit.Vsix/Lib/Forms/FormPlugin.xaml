<forms:BaseDialogWindow  xmlns:forms="clr-namespace:DynamicsCrm.DevKit.Lib.Forms"
        x:Class="DynamicsCrm.DevKit.Lib.Forms.FormPlugin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:wpfcontrols="clr-namespace:DynamicsCrm.DevKit.Lib.WpfControls"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Width="500" SizeToContent="Height" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <forms:BaseDialogWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="StyleResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </forms:BaseDialogWindow.Resources>

    <!-- Layout to keep progress bar fixed at bottom -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Connection -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="5"/>    <!-- Progress bar -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Padding="10,5,10,5" Background="Green">
            <wpfcontrols:ExternalBrowserHyperlink x:Name="HELP" NavigateUri="https://github.com/phuocle/Dynamics-Crm-DevKit/wiki/Connection" Foreground="White">WIKI: Connection</wpfcontrols:ExternalBrowserHyperlink>
        </TextBlock>

        <wpfcontrols:UserControlConnection Grid.Row="1" x:Name="CONNECTION" Connected="Connection_Connected" />

        <!-- Main interactive area (kept same name so code-behind works) -->
        <StackPanel Grid.Row="2" IsEnabled="{Binding IsConnected, ElementName=CONNECTION}" x:Name="StackPanelMain">
            <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="Gray" BorderThickness="1" Padding="10,15,10,15" Margin="5,10,5,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label x:Name="LabelTestPlugin" Grid.Row="0" Grid.Column="0" Margin="0,0,0,5" Content="Plugin" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <ComboBox x:Name="ComboBoxTestPlugin" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5" VerticalContentAlignment="Center" Visibility="Collapsed" IsEditable="False" SelectionChanged="ComboBoxTestPlugin_SelectionChanged" />
                    <Label x:Name="LabelEntity" Grid.Row="2" Grid.Column="0" Margin="0,0,0,5" Content="Entity" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <ComboBox x:Name="ComboBoxEntity" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5" VerticalContentAlignment="Center" IsEditable="False" SelectionChanged="ComboBoxEntity_SelectionChanged" />
                    <Label x:Name="LabelMessage" Grid.Row="3" Grid.Column="0" Margin="0,0,0,5" Content="Message" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <ComboBox x:Name="ComboBoxMessage" Grid.Row="3" Grid.Column="1" Margin="0,0,0,5" VerticalContentAlignment="Center" IsEditable="False" SelectionChanged="ComboBoxMessage_SelectionChanged" />
                    <Label x:Name="LabelStage" Grid.Row="4" Grid.Column="0" Margin="0,0,0,5" Content="Stage" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <ComboBox x:Name="ComboBoxStage" Grid.Row="4" Grid.Column="1" Margin="0,0,0,5" VerticalContentAlignment="Center" IsEditable="False" SelectionChanged="ComboBoxStage_SelectionChanged"/>
                    <Label x:Name="LabelExecution" Grid.Row="5" Grid.Column="0" Margin="0,0,0,5" Content="Execution" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <ComboBox x:Name="ComboBoxExecution" Grid.Row="5" Grid.Column="1" Margin="0,0,0,5" VerticalContentAlignment="Center" IsEditable="False" SelectionChanged="ComboBoxExecution_SelectionChanged" />
                    <Label x:Name="LabelClass" Grid.Row="6" Grid.Column="0" Margin="0,0,0,5" Content="Class" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBox x:Name="TextboxClass" Grid.Row="6" Grid.Column="1" Margin="0,0,0,5" VerticalContentAlignment="Center" TextChanged="TextboxClass_TextChanged" />
                    <Label x:Name="LabelTestClassPreview" Grid.Row="7" Grid.Column="1" Margin="0,0,0,0" Padding="3,2,3,2" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Margin="5,0,8,10">
                    <Button x:Name="buttonOK" Content="OK" Margin="0,0,0,0" Width="80" Height="30" Click="ButtonOK_Click"/>
                    <Button x:Name="buttonCancel" Content="Cancel" Margin="5,0,0,0" Width="80" Height="30" IsCancel="True" Click="ButtonCancel_Click"/>
                </WrapPanel>
                <WrapPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="0,0,0,10" x:Name="TemplatePanel">
                    <Label Content="Template" Margin="0,0,0,0"/>
                    <ComboBox x:Name="ComboBoxTemplate" Margin="0,0,5,0" Width="180" Height="30" VerticalContentAlignment="Center" IsEditable="False" />
                    <Button  x:Name="buttonCustom" Content="..." Margin="0,0,5,0" Width="30" Height="30" Click="ButtonCustom_Click" HorizontalAlignment="Left"/>
                </WrapPanel>
            </Grid>
        </StackPanel>

        <!-- Fixed bottom progress bar -->
        <ProgressBar Grid.Row="3" x:Name="progressBar" Height="5" IsIndeterminate="True" Visibility="Hidden" HorizontalAlignment="Stretch" />
    </Grid>
</forms:BaseDialogWindow>
