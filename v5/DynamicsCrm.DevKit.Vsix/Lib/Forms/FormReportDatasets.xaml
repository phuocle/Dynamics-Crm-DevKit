<forms:BaseDialogWindow
    x:Class="DynamicsCrm.DevKit.Lib.Forms.FormReportDatasets"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:forms="clr-namespace:DynamicsCrm.DevKit.Lib.Forms"
    xmlns:wpfcontrols="clr-namespace:DynamicsCrm.DevKit.Lib.WpfControls"
    mc:Ignorable="d"
    Title="Manage Report Datasets"
    SizeToContent="Manual"
    Width="1600"
    Height="1000"
    MinWidth="1200"
    MinHeight="800"
    d:DesignWidth="1600"
    d:DesignHeight="1000"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    Closing="Window_Closing"
    Loaded="Window_Loaded">
    <forms:BaseDialogWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="StyleResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </forms:BaseDialogWindow.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10,6" Background="Green">
            <TextBlock>
                <wpfcontrols:ExternalBrowserHyperlink
                    NavigateUri="https://github.com/phuocle/Dynamics-Crm-DevKit/wiki/Manage-Report-Datasets"
                    Foreground="White">
                    WIKI: Manage Report Datasets
                </wpfcontrols:ExternalBrowserHyperlink>
            </TextBlock>
        </Border>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="File" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="textboxFile" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center" />
            <Border Grid.Column="2" Margin="10,0,0,0" Padding="8,4" Background="#FFE8F3E8" BorderBrush="Green" BorderThickness="1">
                <TextBlock Text="FetchXML report" Foreground="DarkGreen" />
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Dataset" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox
                x:Name="comboDataset"
                Grid.Column="1"
                DisplayMemberPath="Name"
                SelectionChanged="Dataset_SelectionChanged"
                VerticalContentAlignment="Center" />
            <Label Grid.Column="2" Content="Name" VerticalAlignment="Center" Margin="14,0,8,0" />
            <TextBox x:Name="textboxName" Grid.Column="3" VerticalContentAlignment="Center" ToolTip="Dataset name for a new dataset" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="buttonNew" Content="New" Click="New_Click" Margin="4,0,0,0" Padding="14,5" />
            </StackPanel>
        </Grid>

        <Grid x:Name="contentGrid" Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="260" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="180" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="FetchXML" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox
                x:Name="textboxFetchXml"
                Grid.Row="1"
                AcceptsReturn="True"
                AcceptsTab="True"
                FontFamily="Consolas"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                TextWrapping="NoWrap"
                VerticalContentAlignment="Top"
                TextChanged="FetchXml_TextChanged" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="buttonFormat" Content="Format XML" Click="FormatXml_Click" Margin="0,0,6,0" Padding="14,5" />
                <Button x:Name="buttonValidate" Content="Validate &amp; Refresh Fields" Click="Validate_Click" Padding="14,5" />
            </StackPanel>

            <TabControl Grid.Row="3" Margin="0,8,0,0">
                <TabItem Header="Fields">
                    <DataGrid x:Name="gridFields" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="DataField" Binding="{Binding DataField}" Width="*" />
                            <DataGridTextColumn Header="TypeName" Binding="{Binding TypeName}" Width="140" />
                            <DataGridTextColumn Header="Source path" Binding="{Binding SourceEntityPath}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Parameters">
                    <DataGrid x:Name="gridParameters" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fetch token" Binding="{Binding FetchToken}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Query parameter" Binding="{Binding QueryParameterName}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="Report parameter" Binding="{Binding ReportParameterName}" Width="140" />
                            <DataGridTextColumn Header="Data type" Binding="{Binding DataType}" Width="100" />
                            <DataGridCheckBoxColumn Header="Multi-value" Binding="{Binding IsMultiValue}" Width="85" IsReadOnly="True" />
                            <DataGridTextColumn Header="Value expression" Binding="{Binding ValueExpression}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Pre-filter">
                    <DataGrid
                        x:Name="gridPrefilters"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="False"
                        HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Pre-filter" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsPreFiltered, Mode=TwoWay}" Click="Prefilter_Click" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Entity" Binding="{Binding LogicalName}" Width="160" IsReadOnly="True" />
                            <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Parameter name" Binding="{Binding PrefilterParameterName}" Width="220" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="4" Margin="0,8,0,0" Padding="8" Background="#FFF5F5F5" BorderBrush="#FFD0D0D0" BorderThickness="1">
            <TextBlock x:Name="textStatus" Foreground="DarkBlue" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="5" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="buttonSave" Content="Save RDL" Click="Save_Click" Margin="4,0,0,0" Padding="14,5" />
                <Button x:Name="buttonClose" Content="Close" Click="Close_Click" Margin="4,0,0,0" Padding="14,5" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</forms:BaseDialogWindow>
