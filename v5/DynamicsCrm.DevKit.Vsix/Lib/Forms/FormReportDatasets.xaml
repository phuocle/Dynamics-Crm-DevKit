<forms:BaseDialogWindow
    x:Class="DynamicsCrm.DevKit.Lib.Forms.FormReportDatasets"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:forms="clr-namespace:DynamicsCrm.DevKit.Lib.Forms"
    xmlns:wpfcontrols="clr-namespace:DynamicsCrm.DevKit.Lib.WpfControls"
    Title="Manage Report Datasets"
    Width="1240"
    Height="780"
    MinWidth="960"
    MinHeight="620"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    Closing="Window_Closing">
    <forms:BaseDialogWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="StyleResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </forms:BaseDialogWindow.Resources>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Padding="10,6" Background="Green">
            <wpfcontrols:ExternalBrowserHyperlink
                NavigateUri="https://github.com/phuocle/Dynamics-Crm-DevKit/wiki/Manage-Report-Datasets"
                Foreground="White">
                WIKI: Manage Report Datasets
            </wpfcontrols:ExternalBrowserHyperlink>
        </TextBlock>

        <Grid DockPanel.Dock="Top" Margin="10,8,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="File" VerticalAlignment="Center" />
            <TextBox
                x:Name="textboxFile"
                Grid.Column="1"
                IsReadOnly="True"
                VerticalContentAlignment="Center" />
            <Border Grid.Column="2" Margin="10,0,0,0" Padding="8,4" Background="#FFE8F3E8" BorderBrush="Green" BorderThickness="1">
                <TextBlock Text="Organization Fetch report / MSCRMFETCH" Foreground="DarkGreen" />
            </Border>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Margin="10,6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="buttonFormat" Content="Format XML" Click="FormatXml_Click" Margin="4" Padding="14,5" />
            <Button x:Name="buttonValidate" Content="Validate &amp; Refresh Fields" Click="Validate_Click" Margin="4" Padding="14,5" />
            <Button x:Name="buttonApply" Content="Add Dataset" Click="Apply_Click" Margin="4" Padding="14,5" />
            <Button x:Name="buttonSave" Content="Save" Click="Save_Click" Margin="4" Padding="14,5" />
            <Button Content="Cancel" Click="Cancel_Click" Margin="4" Padding="14,5" IsCancel="True" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="10,0" Padding="8" Background="#FFF5F5F5" BorderBrush="#FFD0D0D0" BorderThickness="1">
            <TextBlock x:Name="textStatus" Foreground="DarkBlue" TextWrapping="Wrap" />
        </Border>

        <Grid x:Name="contentGrid" Margin="10,8,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Orientation="Horizontal">
                    <Button Content="Add" Click="Add_Click" Margin="2" Padding="12,4" />
                    <Button Content="Delete" Click="Delete_Click" Margin="2" Padding="12,4" />
                    <Button Content="Reload" Click="Reload_Click" Margin="2" Padding="12,4" />
                </StackPanel>
                <DataGrid
                    x:Name="gridDatasets"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    SelectionChanged="Dataset_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Entity" Binding="{Binding RootEntityName}" Width="100" />
                        <DataGridTextColumn Header="Fields" Binding="{Binding FieldSummary}" Width="50" />
                        <DataGridTextColumn Header="Params" Binding="{Binding ParameterSummary}" Width="55" />
                        <DataGridTextColumn Header="Filter" Binding="{Binding PreFilterSummary}" Width="50" />
                        <DataGridTextColumn Header="Refs" Binding="{Binding ReferenceSummary}" Width="45" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="250" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Dataset name" VerticalAlignment="Center" />
                    <TextBox x:Name="textboxName" Grid.Column="1" VerticalContentAlignment="Center" />
                    <Label Grid.Column="2" Content="Data source" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Text="Dynamics365" IsReadOnly="True" VerticalContentAlignment="Center" />
                </Grid>

                <TextBox
                    x:Name="textboxFetchXml"
                    Grid.Row="1"
                    AcceptsReturn="True"
                    AcceptsTab="True"
                    FontFamily="Consolas"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    TextWrapping="NoWrap" />

                <TabControl Grid.Row="2" Margin="0,6,0,0">
                    <TabItem Header="Fields">
                        <DataGrid x:Name="gridFields" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="DataField" Binding="{Binding DataField}" Width="*" />
                                <DataGridTextColumn Header="TypeName" Binding="{Binding TypeName}" Width="140" />
                                <DataGridTextColumn Header="Source path" Binding="{Binding SourceEntityPath}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Parameters">
                        <DataGrid x:Name="gridParameters" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fetch token" Binding="{Binding FetchToken}" Width="110" IsReadOnly="True" />
                                <DataGridTextColumn Header="Query parameter" Binding="{Binding QueryParameterName}" Width="130" IsReadOnly="True" />
                                <DataGridTextColumn Header="Report parameter" Binding="{Binding ReportParameterName}" Width="140" />
                                <DataGridTextColumn Header="Data type" Binding="{Binding DataType}" Width="100" />
                                <DataGridCheckBoxColumn Header="Multi-value" Binding="{Binding IsMultiValue}" Width="85" />
                                <DataGridCheckBoxColumn Header="Exists" Binding="{Binding ExistsInReport}" Width="60" IsReadOnly="True" />
                                <DataGridTextColumn Header="Value expression" Binding="{Binding ValueExpression}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Pre-filter">
                        <DockPanel>
                            <CheckBox
                                x:Name="checkboxPrefilter"
                                DockPanel.Dock="Top"
                                Content="Enable pre-filtering"
                                Margin="6"
                                Click="PrefilterToggle_Click" />
                            <DataGrid x:Name="gridPrefilters" AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Pre-filter" Binding="{Binding IsPreFiltered}" Width="70" />
                                    <DataGridTextColumn Header="Entity" Binding="{Binding LogicalName}" Width="120" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="100" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Parameter name" Binding="{Binding PrefilterParameterName}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</forms:BaseDialogWindow>
