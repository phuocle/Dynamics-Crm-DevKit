<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<SignAssembly>True</SignAssembly>
		<AssemblyVersion>4.12.34.56</AssemblyVersion>
		<FileVersion>4.12.34.56</FileVersion>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<RepositoryUrl>https://github.com/phuocle/Dynamics-Crm-DevKit</RepositoryUrl>
		<Company>PhuocLe</Company>
		<Product>DynamicsCrm.DevKit.CrmSvcUtilExtensions</Product>
		<Copyright>Copyright © PhuocLe 2016 - 2036</Copyright>
		<PackageProjectUrl>https://github.com/phuocle/Dynamics-Crm-DevKit</PackageProjectUrl>
		<Version>4.12.34.56</Version>
		<AssemblyTitle>DynamicsCrm.DevKit.CrmSvcUtilExtensions</AssemblyTitle>
		<AssemblyDescription>DynamicsCrm.DevKit.CrmSvcUtilExtensions</AssemblyDescription>
		<BaseOutputPath>bin</BaseOutputPath>
		<DelaySign>False</DelaySign>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>DEBUG;TRACE</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants>TRACE</DefineConstants>
		<OutputPath>bin\Release\</OutputPath>
		<AssemblyOriginatorKeyFile>..\DynamicsCrm.DevKit.pfx</AssemblyOriginatorKeyFile>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="Release\**" />
	  <EmbeddedResource Remove="Release\**" />
	  <None Remove="Release\**" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="*" />
		<PackageReference Include="Microsoft.CrmSdk.CoreTools" Version="9.1.0.179" />
		<PackageReference Include="Microsoft.CrmSdk.Workflow" Version="*" />
		<PackageReference Include="Microsoft.CrmSdk.XrmTooling.CoreAssembly" Version="*" />
	</ItemGroup>
	<ItemGroup>
	  <Reference Include="CrmSvcUtil">
	    <HintPath>lib\CrmSvcUtil.exe</HintPath>
	  </Reference>
	</ItemGroup>
</Project>