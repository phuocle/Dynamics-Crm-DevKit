# Scaffolded template fixture (devkit new smoke tests). The sources here are
# generated verbatim from the VSIX payloads; the DevKit analyzer warnings on
# them are expected, so keep builds of these projects warning-clean instead
# of editing the generated files. No root key: the repository .editorconfig
# still applies underneath.
[*.cs]
dotnet_diagnostic.DEVKIT1001.severity = none
dotnet_diagnostic.DEVKIT1002.severity = none
dotnet_diagnostic.DEVKIT1003.severity = none
dotnet_diagnostic.DEVKIT1004.severity = none
dotnet_diagnostic.DEVKIT1005.severity = none
dotnet_diagnostic.DEVKIT1006.severity = none
dotnet_diagnostic.DEVKIT1007.severity = none
dotnet_diagnostic.DEVKIT1008.severity = none
dotnet_diagnostic.DEVKIT1009.severity = none
dotnet_diagnostic.DEVKIT1010.severity = none
dotnet_diagnostic.DEVKIT1011.severity = none
dotnet_diagnostic.DEVKIT1012.severity = none
dotnet_diagnostic.DEVKIT1013.severity = none
dotnet_diagnostic.DEVKIT1014.severity = none
dotnet_diagnostic.DEVKIT1015.severity = none
dotnet_diagnostic.DEVKIT1016.severity = none
dotnet_diagnostic.DEVKIT1017.severity = none
dotnet_diagnostic.DEVKIT1018.severity = none
dotnet_diagnostic.DEVKIT1019.severity = none
dotnet_diagnostic.DEVKIT1020.severity = none
