{
    "compilerOptions": {
        "baseUrl": ".",
        "checkJs": true,
        "noEmit": true,
        "target": "es6",
        "module": "commonjs",
        "moduleResolution": "node",
        "lib": [
            "es2018",
            "dom"
        ],
        "strict": false,
        "typeRoots": [
            "./node_modules/@types"
        ]
    },
    "include": [
        "entities/**/*",
        "lib/**/*",
        "test/**/*"
    ],
    "exclude": [
        "node_modules",
        "bin",
        "obj"
    ]
}