{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": ".",
        "paths": {
            "*": [
                "node_modules/*",
                "Dev.AllInOne.WebResourceTs/*"
            ]
        }
    },
    "include": [
        "**/*.ts",
        "lib/**/*.ts",
        "lib/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "build"
    ]
}
