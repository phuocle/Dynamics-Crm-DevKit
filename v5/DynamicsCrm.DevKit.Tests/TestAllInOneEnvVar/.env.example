# DynamicsCrm.DevKit project-level connection example.
# Copy this file to .env and fill local secret values.
DEVKIT_AUTH_TYPE=ClientSecret
DEVKIT_URL=https://org.crm.dynamics.com
DEVKIT_CLIENT_ID=00000000-0000-0000-0000-000000000000
DEVKIT_CLIENT_SECRET=replace-with-client-secret
DEVKIT_PAC_PROFILE=default
DEVKIT_USERNAME=user@contoso.com
DEVKIT_PASSWORD=replace-with-password
DEVKIT_DOMAIN=CONTOSO
