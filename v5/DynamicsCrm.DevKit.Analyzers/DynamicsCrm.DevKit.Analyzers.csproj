<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <DevelopmentDependency>true</DevelopmentDependency>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	  <BaseOutputPath>bin</BaseOutputPath>
    <LangVersion>latest</LangVersion>
    <!-- RS1025/RS1026: suppressed because BaseDiagnosticAnalyzer centralizes
         ConfigureGeneratedCodeAnalysis and EnableConcurrentExecution.
         Roslyn's static checker does not trace through base class calls. -->
    <NoWarn>RS1025;RS1026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="10.0.3" />
  </ItemGroup>
</Project>