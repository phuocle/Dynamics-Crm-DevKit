<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Unit tests only use public packages; keep VS solution restore independent from the local release feed. -->
    <RestoreSources Condition="'$(RestoreSources)' == ''">https://api.nuget.org/v3/index.json</RestoreSources>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Client template code under test (shipped inside user projects on .NET Framework) -->
  <ItemGroup>
    <Compile Include="..\ProjectTemplates\CSharp\01.SharedProjectTemplate\Date.cs" Link="Lib\Date.cs" />
    <Compile Include="..\ProjectTemplates\CSharp\01.SharedProjectTemplate\DevKitJson.cs" Link="Lib\DevKitJson.cs" />
  </ItemGroup>

  <!-- Shared model under test by the T4 suite (Shared is a .shproj with no assembly of its own) -->
  <ItemGroup>
    <Compile Include="..\DynamicsCrm.DevKit.Shared\Models\T4Context.cs" Link="T4\T4Context.cs" />
    <Compile Include="..\DynamicsCrm.DevKit.Shared\Const.cs" Link="T4\Const.cs" />
    <Compile Include="..\DynamicsCrm.DevKit.Shared\Enum.cs" Link="T4\Enum.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CoverageReport\**" />
    <Compile Remove="TestResults\**" />
    <EmbeddedResource Remove="CoverageReport\**" />
    <EmbeddedResource Remove="TestResults\**" />
    <None Remove="CoverageReport\**" />
    <None Remove="TestResults\**" />
    <None Remove="DynamicsCrm.DevKit.Vsix.UnitTests.coverage" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Lib\AllDataverseTypes.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Lib\AllDataverseTypes.compact.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="coverlet.runsettings" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
