<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<add key="Url" value="$UrlValue$" />$UrlConfigComment$
		<add key="ClientId" value="$ClientIdValue$" />$ClientIdConfigComment$
		<add key="ClientSecret" value="$ClientSecretValue$" />$ClientSecretConfigComment$
	</appSettings>
</configuration>
