<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<add key="Url" value="$UrlValue$" />$UrlConfigComment$
		<add key="UserName" value="$UserNameValue$" />$UserNameConfigComment$
		<add key="Password" value="$PasswordValue$" />$PasswordConfigComment$
	</appSettings>
</configuration>
