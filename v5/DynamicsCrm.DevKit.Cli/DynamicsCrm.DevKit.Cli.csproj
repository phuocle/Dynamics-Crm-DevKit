<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<TargetFramework>net48</TargetFramework>
		<IsPublishable>True</IsPublishable>
		<SignAssembly>True</SignAssembly>
		<AssemblyVersion>4.12.34.56</AssemblyVersion>
		<FileVersion>4.12.34.56</FileVersion>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<RepositoryUrl>https://github.com/phuocle/Dynamics-Crm-DevKit</RepositoryUrl>
		<Company>PhuocLe</Company>
		<Product>DynamicsCrm.DevKit.Cli</Product>
		<Copyright>Copyright © PhuocLe 2016 - 2036</Copyright>
		<PackageProjectUrl>https://github.com/phuocle/Dynamics-Crm-DevKit</PackageProjectUrl>
		<Version>4.12.34.56</Version>
		<OutputType>Exe</OutputType>
		<StartupObject>DynamicsCrm.DevKit.Cli.Program</StartupObject>
		<BaseOutputPath>bin</BaseOutputPath>
		<DelaySign>False</DelaySign>
		<ApplicationIcon>icon.ico</ApplicationIcon>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<PlatformTarget>x64</PlatformTarget>
		<AssemblyOriginatorKeyFile>..\DynamicsCrm.DevKit.pfx</AssemblyOriginatorKeyFile>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="Nuget\**" />
	  <EmbeddedResource Remove="Nuget\**" />
	  <None Remove="Nuget\**" />
	</ItemGroup>
	<ItemGroup>
	  <Content Include="icon.ico" />
	</ItemGroup>
	<PropertyGroup>
		<NoWarn>CVSTBLD002</NoWarn>
	</PropertyGroup>
	<ItemGroup>
	  <None Include="Nuget\DynamicsCrm.DevKit.Cli.nuspec" />
	  <None Include="Nuget\pack.bat" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="CmdLine" Version="1.0.7.509" />
	  <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="*" />
	  <PackageReference Include="Microsoft.CrmSdk.Workflow" Version="*" />
	  <PackageReference Include="Microsoft.CrmSdk.XrmTooling.CoreAssembly" Version="*" />
	  <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.10" />
	  <!--<PackageReference Include="Microsoft.PowerPlatform.Dataverse.ModelBuilderLib" Version="2.0.16" />-->
	  <PackageReference Include="Microsoft.VisualStudio.Shell.Framework" Version="17.14.40264" />
	  <PackageReference Include="NuGet.Packaging" Version="7.0.1" />
	  <PackageReference Include="NuGet.Protocol" Version="7.0.1" />
	  <!-- Security fix: Add System.Text.RegularExpressions to override vulnerable transitive dependency -->
	  <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
	</ItemGroup>
	<Import Project="..\DynamicsCrm.DevKit.Shared\DynamicsCrm.DevKit.Shared.projitems" Label="Shared" />
</Project>
