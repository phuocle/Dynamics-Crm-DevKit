{
  "mcpServers": {
    "dynamicscrm-devkit": {
      "command": "devkit",
      "args": ["mcp", "devkit-claude"],
      "env": {
        "DEVKIT_AUTH_TYPE": "${DEVKIT_AUTH_TYPE:-FromPac}",
        "DEVKIT_URL": "${DEVKIT_URL}",
        "DEVKIT_PAC_PROFILE": "${DEVKIT_PAC_PROFILE:-default}"
      }
    }
  }
}
