<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Unit tests only use public packages; keep VS solution restore independent from the local release feed. -->
    <RestoreSources Condition="'$(RestoreSources)' == ''">https://api.nuget.org/v3/index.json</RestoreSources>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
    <PackageReference Include="FakeXrmEasy.v9" Version="3.10.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynamicsCrm.DevKit.Cli\DynamicsCrm.DevKit.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Lib\**\*.cs" />
    <Compile Include="Lib\CSharpLateBoundTest.cs" />
    <Compile Include="..\DynamicsCrm.DevKit.Vsix.UnitTests\Lib\DevKitJsonRoundTripTests.cs" Link="Cli\DevKitJsonRoundTripTests.cs" />
    <Compile Remove="CoverageReport\**" />
    <Compile Remove="TestResults\**" />
    <EmbeddedResource Remove="CoverageReport\**" />
    <EmbeddedResource Remove="TestResults\**" />
    <None Remove="CoverageReport\**" />
    <None Remove="TestResults\**" />
    <None Remove="DynamicsCrm.DevKit.Cli.UnitTests.coverage" />
    <Content Include="Cli\Account.FormXrml.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Account.FormXrml.xml</Link>
    </Content>
  </ItemGroup>
</Project>
