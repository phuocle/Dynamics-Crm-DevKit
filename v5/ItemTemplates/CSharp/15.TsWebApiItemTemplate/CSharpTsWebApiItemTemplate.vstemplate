<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" xmlns:sdk="http://schemas.microsoft.com/developer/vstemplate-sdkextension/2010">
	<TemplateData>
		<Name>15. TypeScript WebApi</Name>
		<Description>Generates a Dynamics 365 TypeScript webapi scaffold for early-bound style form coding. Includes .webapi.ts file with typed interfaces.</Description>
		<DefaultName>TypeScript.webapi.ts</DefaultName>
		<TemplateID>AAAAAAAA-AAAA-AAAA-BBBB-000000000015</TemplateID>
		<Icon>icon.png</Icon>
		<ProjectType>CSharp</ProjectType>
		<ProjectSubType>Visual C#</ProjectSubType>
		<AppliesTo>CSharp</AppliesTo>
		<RequiredFrameworkVersion>4.0</RequiredFrameworkVersion>
		<NumberOfParentCategoriesToRollUp>0</NumberOfParentCategoriesToRollUp>
		<SortOrder>250</SortOrder>
	</TemplateData>
	<TemplateContent>
		<ProjectItem ReplaceParameters="true" OpenInEditor="false" TargetFileName="$SchemaName$.webapi.ts">TypeScript.webapi.ts</ProjectItem>
		<ProjectItem ReplaceParameters="true" OpenInEditor="false" TargetFileName="$SchemaName$.ts">TypeScript.ts</ProjectItem>
	</TemplateContent>
	<WizardExtension>
		<Assembly>DynamicsCrm.DevKit, Version=4.99.99.99, Culture=Neutral, PublicKeyToken=null</Assembly>
		<FullClassName>DynamicsCrm.DevKit.Wizard.ItemTemplates.TsWebApi</FullClassName>
	</WizardExtension>
</VSTemplate>
