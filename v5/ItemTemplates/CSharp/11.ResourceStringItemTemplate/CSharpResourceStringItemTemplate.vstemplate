<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" xmlns:sdk="http://schemas.microsoft.com/developer/vstemplate-sdkextension/2010">
	<TemplateData>
		<Name>11. Resource String</Name>
		<Description>Creates a Dataverse localization resource (.resx) file for centralizing multi-language strings used across plugins, custom APIs, workflows, tests, and client scripts.</Description>
		<Icon>icon.png</Icon>
		<TemplateID>AAAAAAAA-AAAA-AAAA-BBBB-000000000010</TemplateID>
		<ProjectType>CSharp</ProjectType>
		<ProjectSubType>Visual C#</ProjectSubType>
		<AppliesTo>CSharp</AppliesTo>
		<RequiredFrameworkVersion>4.0</RequiredFrameworkVersion>
		<NumberOfParentCategoriesToRollUp>0</NumberOfParentCategoriesToRollUp>
		<DefaultName>ResourceString.resx</DefaultName>
		<SortOrder>210</SortOrder>
	</TemplateData>
	<TemplateContent>
		<ProjectItem ReplaceParameters="true" TargetFileName="$Class$$PluginOrder$.$LanguageCode$.resx">ResourceString.resx</ProjectItem>
	</TemplateContent>
	<WizardExtension>
		<Assembly>DynamicsCrm.DevKit, Version=4.99.99.99, Culture=Neutral, PublicKeyToken=null</Assembly>
		<FullClassName>DynamicsCrm.DevKit.Wizard.ItemTemplates.ResourceString</FullClassName>
	</WizardExtension>
</VSTemplate>