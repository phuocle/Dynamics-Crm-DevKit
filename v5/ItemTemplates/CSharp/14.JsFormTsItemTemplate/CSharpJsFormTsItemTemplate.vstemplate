<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" xmlns:sdk="http://schemas.microsoft.com/developer/vstemplate-sdkextension/2010">
	<TemplateData>
		<Name>14. TypeScript Form</Name>
		<Description>Generates a Dynamics 365 TypeScript form scaffold for early-bound style form coding. Includes .form.ts file with typed interfaces.</Description>
		<DefaultName>TypeScript.form.ts</DefaultName>
		<TemplateID>AAAAAAAA-AAAA-AAAA-BBBB-000000000014</TemplateID>
		<Icon>icon.png</Icon>
		<ProjectType>CSharp</ProjectType>
		<ProjectSubType>Visual C#</ProjectSubType>
		<AppliesTo>CSharp</AppliesTo>
		<RequiredFrameworkVersion>4.0</RequiredFrameworkVersion>
		<NumberOfParentCategoriesToRollUp>0</NumberOfParentCategoriesToRollUp>
		<SortOrder>140</SortOrder>
	</TemplateData>
	<TemplateContent>
		<ProjectItem ReplaceParameters="true" OpenInEditor="false" TargetFileName="$SchemaName$.form.ts">TypeScript.form.ts</ProjectItem>
	</TemplateContent>
	<WizardExtension>
		<Assembly>DynamicsCrm.DevKit, Version=4.12.34.56, Culture=Neutral, PublicKeyToken=null</Assembly>
		<FullClassName>DynamicsCrm.DevKit.Wizard.ItemTemplates.JsFormTs</FullClassName>
	</WizardExtension>
</VSTemplate>
