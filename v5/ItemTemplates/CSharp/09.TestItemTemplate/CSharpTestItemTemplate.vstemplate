<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" xmlns:sdk="http://schemas.microsoft.com/developer/vstemplate-sdkextension/2010">
	<TemplateData>
		<Name>09. C# Test Class</Name>
		<Description>Accelerates Dataverse development by providing a robust test project template, pre-configured with FakeXrmEasy for seamless unit testing and mocking of Dataverse plugins, workflows, and custom logic.</Description>
		<DefaultName>Class.cs</DefaultName>
		<TemplateID>AAAAAAAA-AAAA-AAAA-BBBB-000000000005</TemplateID>
		<Icon>icon.png</Icon>
		<ProjectType>CSharp</ProjectType>
		<ProjectSubType>Visual C#</ProjectSubType>
		<AppliesTo>CSharp</AppliesTo>
		<RequiredFrameworkVersion>4.0</RequiredFrameworkVersion>
		<NumberOfParentCategoriesToRollUp>0</NumberOfParentCategoriesToRollUp>
		<SortOrder>190</SortOrder>
	</TemplateData>
	<TemplateContent>
		<ProjectItem ReplaceParameters="true" TargetFileName="$Class$$PluginOrder$Test.cs">Class.cs</ProjectItem>
	</TemplateContent>
	<WizardExtension>
		<Assembly>DynamicsCrm.DevKit, Version=4.44.44.44, Culture=Neutral, PublicKeyToken=null</Assembly>
		<FullClassName>DynamicsCrm.DevKit.Wizard.ItemTemplates.Test</FullClassName>
	</WizardExtension>
</VSTemplate>